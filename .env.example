LLM_BASE_URL=http://192.168.3.18:8000/v1
LLM_MODEL=replace-with-remote-model
LLM_API_KEY=
LLM_CORRECTION_ENABLED=true
LLM_CORRECTION_MAX_TOKENS=256
LLM_CORRECTION_SYSTEM_PROMPT=你是中文语音识别纠错器。只修正明显的同音词、技术术语、人名和专有名词错误。不新增、不删减、不总结，只输出修正后的文本。术语映射：后视网络模式->host 网络模式；后视->host；单科->单机；多科->多机；集群机->集群；宗师->忠思；下限->下线；冷资源中心->云资源中心；光单->关单；空单->工单；谷歌表哥->Google 表格；嫁给豆包->交给豆包。保留技术术语中英文之间的空格。
MEETING_RULE_CORRECTION_ENABLED=true
# 默认关闭 LLM 纠错；开启后也只处理下面显式配置的候选映射
MEETING_LLM_CORRECTION_ENABLED=false
MEETING_LLM_CORRECTION_CANDIDATES=
ASR_ENGINE=mlx
ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-4bit
ASR_LANGUAGE=Chinese
ASR_MAX_TOKENS=512
ASR_REPETITION_PENALTY=1.08
ASR_REPETITION_CONTEXT_SIZE=100
ASR_CHUNK_DURATION_SECONDS=30
ASR_LONG_AUDIO_THRESHOLD_SECONDS=60
ASR_HOTWORDS=host,host 网络模式,网络模式,大佬
ASR_SYSTEM_PROMPT=你是一个专业的中文语音转写器。只输出音频中实际说出的内容，不要补充、解释或改写。
VAD_MODEL=models/silero_vad.onnx
PUNCTUATION_ENABLED=true
# passthrough 无额外模型；funasr 使用 ct-punc-c 恢复标点
PUNCTUATION_ENGINE=passthrough
PUNCTUATION_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
PUNCTUATION_DEVICE=mps
SD_ENGINE=resemblyzer
SPEAKER_STORE_PATH=~/.astra/speakers.sqlite3
# 初始值，需用真实注册样本校准
SPEAKER_MATCH_THRESHOLD=0.75
SPEAKER_MATCH_MARGIN=0.05
SHERPA_MODEL_DIR=models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
SHERPA_NUM_THREADS=2
SHERPA_PROVIDER=cpu
SHERPA_AUTO_LANGUAGE=true
SHERPA_USE_ITN=true
# Zipformer Bilingual (zh+en, streaming transducer optimized for code-switching, ~80MB int8
# ASR_ENGINE values: mlx | sherpa (sensevoice) | zipformer (or zipformer-bilingual, sherpa-zipformer
ZIPFORMER_MODEL_DIR=models/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20
ZIPFORMER_NUM_THREADS=2
ZIPFORMER_PROVIDER=cpu
ZIPFORMER_DECODING_METHOD=greedy_search
TTS_MODEL_PATH=models/zh_CN-huayan-medium.onnx
FRONTEND_PORT=8080
