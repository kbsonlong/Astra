LLM_BASE_URL=http://192.168.3.18:8000/v1
LLM_MODEL=replace-with-remote-model
LLM_API_KEY=
# 管理员认证：局域网暴露服务前必须替换为随机高熵值；绝不提交真实值。
ADMIN_TOKEN=replace-with-a-long-random-token
# 推荐独立于 ADMIN_TOKEN，用于使会话失效或轮换时不必更改登录令牌。
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
ADMIN_SESSION_TTL_SECONDS=43200
# Nginx 终止 HTTPS 后设置为 true；纯 HTTP 局域网部署保持 false，否则浏览器不会发送 Cookie。
AUTH_COOKIE_SECURE=false
LLM_CORRECTION_ENABLED=true
LLM_CORRECTION_MAX_TOKENS=256
LLM_CORRECTION_SYSTEM_PROMPT=你是中文语音识别纠错器。只修正明显的同音词、技术术语、人名和专有名词错误。不新增、不删减、不总结，只输出修正后的文本。术语映射：后视网络模式->host 网络模式；后视->host；单科->单机；多科->多机；宗师->忠思；下限->下线；冷资源中心->云资源中心；光单->关单；空单->工单；谷歌表哥->Google 表格；嫁给豆包->交给豆包。保留技术术语中英文之间的空格。
MEETING_RULE_CORRECTION_ENABLED=true
# 默认关闭 LLM 纠错；开启后也只处理下面显式配置的候选映射
MEETING_LLM_CORRECTION_ENABLED=false
MEETING_LLM_CORRECTION_CANDIDATES=
ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-4bit
ASR_LANGUAGE=Chinese
ASR_MAX_TOKENS=512
ASR_REPETITION_PENALTY=1.08
ASR_REPETITION_CONTEXT_SIZE=100
# 实时 ASR 固定线程 worker：队列满会返回 503；请求超时不会抢占已执行的 MLX 推理。
ASR_WORKER_QUEUE_SIZE=8
ASR_WORKER_REQUEST_TIMEOUT_SECONDS=120
ASR_WORKER_SHUTDOWN_TIMEOUT_SECONDS=5
ASR_CHUNK_DURATION_SECONDS=30
ASR_LONG_AUDIO_THRESHOLD_SECONDS=60
ASR_HOTWORDS=host,host 网络模式,网络模式,大佬
ASR_SYSTEM_PROMPT=你是一个专业的中文语音转写器。只输出音频中实际说出的内容，不要补充、解释或改写。
VAD_MODEL=models/silero_vad.onnx
PUNCTUATION_ENABLED=true
# passthrough 无额外模型；funasr 使用 ct-punc-c 恢复标点
PUNCTUATION_ENGINE=passthrough
PUNCTUATION_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
PUNCTUATION_DEVICE=mps
SD_ENGINE=resemblyzer
SPEAKER_STORE_PATH=~/.astra/speakers.sqlite3
# 初始值，需用真实注册样本校准
SPEAKER_MATCH_THRESHOLD=0.75
SPEAKER_MATCH_MARGIN=0.05
SPEAKER_MAX_SPEAKERS=32
SPEAKER_DUPLICATE_THRESHOLD=0.82
SPEAKER_SAMPLE_DIR=~/.astra/speaker_samples
TTS_MODEL_PATH=models/zh_CN-huayan-medium.onnx
# 训练参数由前端保存到该 JSON；训练由独立进程执行
QWEN3_TRAINING_CONFIG_PATH=~/.astra/qwen3-asr-training.json
FRONTEND_PORT=8080
# Compose 中 Nginx 反代的 FastAPI 地址（不含 http://）；Mac Docker Desktop 默认可访问宿主机后端。
# 后台会议/训练任务的可重启 SQLite 登记。
TASK_STORE_PATH=~/.astra/tasks.sqlite3
API_UPSTREAM=host.docker.internal:8000
# Nginx 上传大小限制；需与后端会议接口允许的 500MB 保持一致。
NGINX_CLIENT_MAX_BODY_SIZE=500m
# 后端资源上限：实时转写与单个 WebSocket 会话默认最多 25MiB；会议上传默认最多 500MiB。
TRANSCRIBE_MAX_UPLOAD_BYTES=26214400
MEETING_MAX_UPLOAD_BYTES=524288000
WS_MAX_AUDIO_BYTES=26214400
